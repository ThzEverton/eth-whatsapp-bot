{
  "name": "whatsapp-game-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node monitor/sync-ui.mjs",
    "start": "node dist/index.js",
    "monitor": "node monitor/server.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "format": "prettier --write src package.json tsconfig.json README.md",
    "app": "npm run build && node monitor/server.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^17.2.3",
    "pino": "^10.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.2",
    "lucide": "^1.53.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
